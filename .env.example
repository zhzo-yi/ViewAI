SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
# 本版本默认指向 DeepSeek 官方；继续用硅基流动则改为 https://api.siliconflow.cn/v1
SILICONFLOW_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
# V4 系列推理耗时远高于 V3.2，沿用 120000 容易在 Executor 阶段耗尽预算
AGENT_MAX_DURATION_MS=600000
AGENT_MAX_ESTIMATED_TOKENS=200000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
# 以下两项仅在 provider=siliconflow 时使用
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR

# ASR 与 Embedding 的服务商：siliconflow 或 bailian（阿里云百炼）。
# 两者可以分别切换；siliconflow 沿用上面的 SILICONFLOW_* 与 EMBEDDING_MODEL/ASR_MODEL，
# bailian 使用下面的 ALIYUN_API_KEY 与 ALIYUN_*_MODEL。
ASR_PROVIDER=bailian
EMBEDDING_PROVIDER=bailian
# 仅当上面任一 provider=bailian 时需要填写。百炼 Key 从 https://bailian.console.aliyun.com 获取。
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_ASR_MODEL=qwen3-asr-flash
ALIYUN_EMBEDDING_MODEL=text-embedding-v4
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
# 部分站点（如 B 站）缺少登录态会返回 HTTP 412，需要提供 cookie 才能下载在线视频链接。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
FFMPEG_DIR=
OCR_COMMAND=tesseract
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
